{
  "name": "virtual-servient",
  "version": "0.2.0",
  "private": true,
  "description": "Producer servient for WoTBot virtual Things",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "VIRTUAL_SERVIENT_REGISTRY_TOKEN=test tsx --test src/**/*.test.ts",
    "gen:schema": "(cd ../wotbot && ${PYTHON:-python3} -m wotbot.virtual_things.contract_export) > schema/servient-view.schema.json",
    "gen:types": "npm run gen:schema && node scripts/gen-types.mjs",
    "check:contract": "npm run gen:types && git diff --exit-code -- schema/servient-view.schema.json src/types.generated.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@node-wot/binding-coap": "^0.9.2",
    "@node-wot/binding-file": "^0.9.2",
    "@node-wot/binding-http": "^0.9.2",
    "@node-wot/binding-mbus": "^0.9.2",
    "@node-wot/binding-modbus": "^0.9.2",
    "@node-wot/binding-mqtt": "^0.9.2",
    "@node-wot/core": "^0.9.2",
    "axios": "^1.7.7",
    "express": "^4.21.1",
    "ioredis": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.8.0",
    "globals": "^17.4.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
