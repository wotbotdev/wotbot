# WoTBot environment template
#
# Copy this file to `.env` before starting Docker Compose. The Compose stack
# wires internal service URLs for normal local development; override them only
# when running services outside that network.

# =============================================================================
# Required
# =============================================================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Enable when the configured main model accepts image inputs. While a live
# camera is active, one current frame is attached to every foreground turn.
OPENAI_MODEL_SUPPORTS_VISION=false
# Optional. Leave unset to use the provider/model default; set 0 for conservative output.
# OPENAI_TEMPERATURE=0
# Optional. Values: tool_calling, true, false. tool_calling keeps tool calls atomic.
OPENAI_DISABLE_STREAMING=tool_calling
# Optional custom OpenAI-compatible endpoint.
OPENAI_API_BASE_URL=

# Lets the full chat UI ask a reasoning-capable model (o-series, gpt-5, etc.)
# how hard to think. The UI reads these same values from its runtime environment,
# so one shared configuration controls both services. Off by default.
REASONING_EFFORT_ENABLED=false
REASONING_EFFORT_LEVELS=low,medium,high
# Optional. Baseline reasoning_effort for every LLM call (chat, jobs, LiveKit,
# enrichment) when REASONING_EFFORT_ENABLED=true. Must be one of the levels above.
REASONING_EFFORT_DEFAULT=
# How a resolved level is sent to the model. "openai" (default) sends the
# OpenAI/vLLM-standard reasoning_effort field. "qwen" instead sets Qwen's own
# enable_thinking chat-template flag via extra_body — some vLLM/Qwen
# deployments don't reliably honor reasoning_effort themselves (see
# https://github.com/vllm-project/vllm/issues/35574). Qwen's switch is
# binary: the level "none" means thinking off, every other configured level
# means on. "openrouter" sends OpenRouter's own reasoning object, which is
# required to get the reasoning text back at all — given a plain
# reasoning_effort, OpenRouter bills the reasoning tokens and reports them in
# output_token_details.reasoning but returns the reasoning field empty. Its
# effort scale has no "none", so that level disables reasoning instead.
REASONING_EFFORT_STYLE=openai

# Shared service secrets. Replace all defaults outside disposable local setups.
INIT_ADMIN_TOKEN=change-me
INTERNAL_API_KEY=change-me
WOT_RUNTIME_REGISTRY_TOKEN=change-me
WOT_RUNTIME_API_TOKEN=change-me

# =============================================================================
# Persistence and internal service URLs
# =============================================================================

# Docker Compose defaults to these values. If you change them, also set
# REGISTRY_DATABASE_URL to match.
POSTGRES_DB=wotbot
POSTGRES_USER=wotbot
POSTGRES_PASSWORD=wotbot
REGISTRY_DATABASE_URL=postgresql://wotbot:wotbot@postgres:5432/wotbot
# Leave blank to store LangGraph checkpoints in REGISTRY_DATABASE_URL.
AGENT_STATE_DATABASE_URL=

REDIS_URL=redis://valkey:6379
# Public origin used in Agent Cards and generated artifact URLs.
REGISTRY_PUBLIC_URL=http://localhost:8123

# Compose defaults. Use localhost URLs when running services directly on the host.
CODE_EXECUTOR_URL=http://code-executor:8888
WOT_RUNTIME_URL=http://wot-runtime:3003

# Opt-in inbound A2A 1.0 and generated MCP Apps. Use an API key with agent:invoke.
# REGISTRY_PUBLIC_URL must be the backend origin reachable by external clients
# (e.g. https://api.example.com), not a Docker-only service name, when enabled.
A2A_ENABLED=false
MCP_ENABLED=false
PUBLIC_UI_ORIGIN=http://localhost:3000
A2A_TASK_RETENTION_DAYS=30
A2A_ARTIFACT_RETENTION_DAYS=7
# Browser/image download links grant access to one artifact for one hour.
A2A_DOWNLOAD_URL_TTL_SECONDS=3600
A2A_MAX_ARTIFACT_BYTES=26214400
# Additional comma-separated MCP Host header values and browser origins.
# The REGISTRY_PUBLIC_URL host/origin is already allowed. No wildcards needed.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Source Things keep external discovery configuration in the catalog. Only
# temporary candidate and download capability lifetimes are environment settings.
DISCOVERY_CANDIDATE_TTL_SECONDS=1800
DISCOVERY_DOWNLOAD_TTL_SECONDS=300

# =============================================================================
# UI
# =============================================================================

# Generated panels are served from an origin of their own, one per panel, so a
# panel cannot reach the app's DOM, storage or cookies and its camera/microphone
# grant is scoped to itself. `{key}` is replaced with the panel's id.
# Locally this needs no setting: Chrome resolves any *.localhost to loopback and
# treats it as a secure context, so panels land on <id>.panels.localhost.
# In production set it and provide matching wildcard DNS plus a wildcard
# certificate, e.g. {key}.panels.example.com. Read at runtime by the server and
# published on the document, so a plain .env entry takes effect without
# rebuilding the image. `{key}` must be the leading label; anything else is
# ignored in favour of the derived host.
PANEL_HOST_TEMPLATE=

NEXT_PUBLIC_ENABLE_COPILOT_INSPECTOR=false
# Comma-separated parent origins allowed to drive /embed/chat via postMessage.
# Defaults to the UI's own origin. Use exact origins such as http://localhost:8080.
EMBED_CHAT_ALLOWED_ORIGINS=
# Set to a positive value if file watching needs polling in your local Docker setup.
NEXT_POLL_INTERVAL_MS=0
# Optional registry token for UI server-side registry requests; defaults to INIT_ADMIN_TOKEN.
WOT_REGISTRY_TOKEN=

# =============================================================================
# WoTBot agent
# =============================================================================

MAX_CONTEXT_TOKENS=120000
RECURSION_LIMIT=50
# Let the model request several tools in one turn. Kept off for a long time
# because ag-ui-langgraph mis-attributed streamed tool-call arguments when two
# calls overlapped (upstream issue #1016). That is fixed as of the pinned
# 0.0.43 by its boundary-transition guard. The typed middleware now has
# deterministic interleaved-ID coverage, and one live local run on the pinned
# stack correctly attributed a heterogeneous registry_health + things_search
# pair. The wider search/property/read matrix is still incomplete, so keep this
# off by default and re-test per provider (and whenever the adapter pin moves).
PARALLEL_TOOL_CALLS=false
# Allow action branches (control/analysis/jobs/virtual_things) to hand off to
# one another within a single turn (e.g. create a virtual thing, then analyze
# it). Off by default; the graph then behaves as a single-branch router.
AGENT_HANDOFF_ENABLED=false

CODE_EXECUTOR_TIMEOUT_SECONDS=330
CODE_EXECUTOR_RETRY_ATTEMPTS=3
CODE_EXECUTOR_RETRY_BACKOFF_SECONDS=1.0

WOT_RUNTIME_TIMEOUT_SECONDS=15
WOT_RUNTIME_SUBSCRIPTION_TIMEOUT_SECONDS=5
WOT_RUNTIME_ACTION_TIMEOUT_SECONDS=135

# =============================================================================
# Search and Thing indexing
# =============================================================================

OPENAI_EMBEDDING_API_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=mxbai-embed-large
SEARCH_VECTOR_DIMENSIONS=1024

THING_EVENTS_STREAM=thing_events
THING_EVENT_OUTBOX_BATCH_SIZE=20
THING_EVENT_OUTBOX_POLL_INTERVAL_SECONDS=0.5

SEARCH_INDEXER_EVENTS_GROUP=thing_search_indexer
SEARCH_INDEXER_POLL_BLOCK_MS=5000
SEARCH_INDEXER_BATCH_SIZE=20
SEARCH_INDEXER_CLAIM_IDLE_MS=60000
SEARCH_INDEXER_RETRY_SECONDS=5

RDF_SERVICE_URL=http://rdf-service:8124
RDF_STORE_PATH=/data/rdf
RDF_EVENTS_GROUP=thing_rdf_indexer
RDF_EVENTS_POLL_BLOCK_MS=5000
RDF_EVENTS_BATCH_SIZE=20
RDF_EVENTS_CLAIM_IDLE_MS=60000
RDF_EVENTS_RETRY_SECONDS=5
RDF_QUERY_TIMEOUT_SECONDS=20

# =============================================================================
# Automation jobs
# =============================================================================

JOBS_ENABLED=true
JOB_TASK_TIMEOUT_SECONDS=300
JOB_RUN_STALE_AFTER_SECONDS=900
JOBS_DEFAULT_TIMEZONE=Europe/Berlin
JOBS_RUN_EVENTS_STREAM=jobs_run_events
JOB_SCHEDULER_UPDATE_INTERVAL_SECONDS=2

JOBS_EVENTS_GROUP=job_runner
JOBS_STREAM_BATCH_SIZE=20
JOBS_STREAM_POLL_BLOCK_MS=5000
JOBS_STREAM_CLAIM_IDLE_MS=60000

# =============================================================================
# Live media and speech
# =============================================================================

# Self-hosted LiveKit media transport. These defaults match the local
# `livekit` service in docker-compose.
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=wotbot
LIVEKIT_ROOM_PREFIX=wotbot
LIVEKIT_TOKEN_TTL_SECONDS=600

# Speech-to-text (OpenAI-compatible /audio/transcriptions; leave the URL blank
# to reuse OPENAI_API_BASE_URL and OPENAI_API_KEY -- e.g. for OpenRouter, whose
# models are namespaced: openai/whisper-large-v3-turbo, google/chirp-3, ...)
STT_TRANSCRIPTIONS_URL=
STT_MODEL=whisper-large-turbo
STT_API_KEY=
STT_LANGUAGE=

# Text-to-speech (OpenAI-compatible; leave TTS_SPEECH_URL blank to reuse OPENAI_API_BASE_URL)
TTS_SPEECH_URL=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_API_KEY=
TTS_RESPONSE_FORMAT=pcm
TTS_SPEED=1.0
# How /audio/speech streams the audio back. "audio" (default) reads the raw
# byte stream, the one dialect every OpenAI-compatible server serves; OpenRouter
# serves only that one, ignoring stream_format and always answering with
# audio/pcm. Use "sse" for OpenAI's own token-billed voices
# (gpt-4o-mini-tts and newer); "auto" restores livekit-plugins-openai's guess
# from the model name, which picks SSE for anything but tts-1/tts-1-hd.
TTS_STREAM_FORMAT=audio

# Camera frames are encoded continuously so a fresh frame is ready when the
# main model is called; there is no separate vision model or camera tool.
CAMERA_FRAME_MAX_DIMENSION=1024
CAMERA_FRAME_JPEG_QUALITY=85

# =============================================================================
# Code executor service
# =============================================================================

IDLE_TIMEOUT_SECONDS=1800
EXECUTION_TIMEOUT_SECONDS=300
MAX_SESSIONS=50
ARTIFACTS_DIR=/tmp/code-executor-artifacts
# Charts and images. A2A and chat both link to these after the turn that
# produced them, so they are retained as long as exported files.
ARTIFACTS_TTL_SECONDS=604800
# Exported files have separate retention and limits. Compose persists the
# default artifact directory on a named volume.
FILE_ARTIFACTS_TTL_SECONDS=604800
ARTIFACT_MAX_BYTES=67108864
ARTIFACT_MAX_FILES_PER_EXECUTION=16
ARTIFACT_MAX_EXECUTION_BYTES=268435456

# =============================================================================
# WoT runtime service
# =============================================================================

# REGISTRY_SERVICE_NAME is intentionally unset: wot-runtime and virtual-servient
# share this file and use different built-in service identities.
HTTP_REQUEST_TIMEOUT_MS=10000
WOT_PROVIDER_ACTION_TIMEOUT_MS=135000
WOT_RUNTIME_STREAM=wot_runtime_events
WOT_SUBSCRIPTION_SETUP_TIMEOUT_MS=0
SECRETS_REFRESH_INTERVAL_MS=60000
REQUEST_BODY_LIMIT=50mb
WOT_CACHE_ENABLED=true
WOT_CACHE_TTL_SECONDS=300
WOT_CACHE_MAX_BYTES=10485760

# =============================================================================
# Virtual servient service
# =============================================================================

# Defaults to WOT_RUNTIME_REGISTRY_TOKEN in Docker Compose when left blank.
VIRTUAL_SERVIENT_REGISTRY_TOKEN=
VIRTUAL_SERVIENT_PUBLIC_URL=http://virtual-servient:3014
VIRTUAL_SERVIENT_EVENTS_GROUP=virtual_servient
VIRTUAL_SERVIENT_RECONCILE_INTERVAL_MS=30000

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO
